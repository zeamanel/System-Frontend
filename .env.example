# SenedDesk frontend environment
# Copy to `.env.local` for local overrides. Only variables prefixed with VITE_
# are exposed to the browser — never put secrets here.

# Base URL of the SenedDesk backend API (separate repository).
# Accepts an absolute http(s) URL (e.g. https://api.docua4.example) or a
# root-relative path (e.g. /api) when requests are proxied from the same origin.
# Defaults: http://localhost:8787 in dev, /api in production builds.
VITE_API_BASE_URL=http://localhost:8787

# Data layer for feature content (templates, documents, notifications…):
#   fixtures — clearly-labeled development data served from the browser
#   http     — the live SenedDesk backend
# Defaults: fixtures in dev; production builds must set this explicitly.
VITE_DATA_SOURCE=fixtures

# Firebase Web SDK configuration (public client identifiers, not secrets).
# Required when VITE_DATA_SOURCE=http; ignored in fixture mode. Values come
# from the Firebase console for project system-backend-511115.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=system-backend-511115.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=system-backend-511115
VITE_FIREBASE_STORAGE_BUCKET=system-backend-511115.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=506195874849
VITE_FIREBASE_APP_ID=

# Display name used across the UI shell.
VITE_APP_NAME=SenedDesk

# Default UI locale before a user preference is detected. One of: en | am.
VITE_DEFAULT_LOCALE=en

# Who runs the service, shown on the Terms of Service, Privacy Policy and About pages.
# Until these are set the pages show a visible [placeholder] in their place.
VITE_LEGAL_NAME=
VITE_CONTACT_EMAIL=
VITE_LEGAL_ADDRESS=
