# DocuA4 frontend environment
# Copy to `.env.local` for local overrides. Only variables prefixed with VITE_
# are exposed to the browser — never put secrets here.

# Base URL of the DocuA4 backend API (separate repository).
# Accepts an absolute http(s) URL (e.g. https://api.docua4.example) or a
# root-relative path (e.g. /api) when requests are proxied from the same origin.
# Defaults: http://localhost:8787 in dev, /api in production builds.
VITE_API_BASE_URL=http://localhost:8787

# Display name used across the UI shell.
VITE_APP_NAME=DocuA4

# Default UI locale before a user preference is detected. One of: en | am.
VITE_DEFAULT_LOCALE=en
